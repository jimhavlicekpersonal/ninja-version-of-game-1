<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31): what cloud backup and device-to-device transfer may copy
  (re-audit). The game's localStorage holds the online sign-in token, this
  device's command-queue id and the unsent action queue: copied to another
  device they would make two phones the same online device (or hand an account
  to whoever restores the backup). It is excluded everywhere. The village save
  (WebView IndexedDB) is still backed up, like before: saves are per device, and
  the server keeps a village moved there (cloud save is a linked sign-in).
  Chromium has kept localStorage under app_webview/Default/ and, in older
  WebViews, directly under app_webview/; both are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/Default/Local Storage/" />
        <exclude domain="root" path="app_webview/Local Storage/" />
        <exclude domain="root" path="app_webview/Default/Session Storage/" />
        <exclude domain="root" path="app_webview/Default/Cookies" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/Default/Local Storage/" />
        <exclude domain="root" path="app_webview/Local Storage/" />
        <exclude domain="root" path="app_webview/Default/Session Storage/" />
        <exclude domain="root" path="app_webview/Default/Cookies" />
    </device-transfer>
</data-extraction-rules>
