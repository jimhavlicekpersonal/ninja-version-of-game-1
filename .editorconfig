# Basic formatting shared by every editor (quality 6). The code is not run through a formatter:
# see docs/DECISIONS.md (tooling) for why.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{java,swift,gradle,kt,py}]
indent_size = 4

[Makefile]
indent_style = tab
