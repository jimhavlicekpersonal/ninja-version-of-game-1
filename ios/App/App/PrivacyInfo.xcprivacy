<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Beast Mode 2026-11-21 OPS-10: the app's own privacy manifest. Must match docs/store/PRIVACY.md
     ("App Store privacy label") and public/privacy.html; tests/backend/release-config.test.ts holds them together.
     No required-reason API is used by the app's own Swift today: add NSPrivacyAccessedAPITypes (for example
     UserDefaults, reason CA92.1) in the same commit that starts using one. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
