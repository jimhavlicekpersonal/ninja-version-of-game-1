+/** SCRATCH PROTOTYPE: per-building-type damage bonus against warrior classes (battle.counterBonus). */
+function counterMult(sim: BattleSim, bi: number | undefined, t: SimTroop): number {
+  const cfg = (sim.data.battle as any).counterBonus as Record<string, { vs: Record<string, number>; only?: number }> | undefined;
+  if (!cfg || bi === undefined) return 1;
+  const b = sim.buildings[bi];
+  const c = cfg[b.type];
+  if (!c) return 1;
+  if (c.only !== undefined) {
+    let k = 0;
+    for (let i = 0; i < bi; i++) if (sim.buildings[i].type === b.type) k++;
+    if (k >= c.only) return 1;
+  }
+  const def = troopDef(sim.data, t.type);
+  let m = 1;
+  const cls: string[] = [];
+  if (def.air) cls.push('air');
+  if (!def.air && def.range >= 3.5) cls.push('ranged');
+  if (def.housing >= 5) cls.push('tank');
+  if (def.kit?.stealth) cls.push('stealth');
+  for (const k of cls) m = Math.max(m, 1 + (c.vs[k] ?? 0));
+  return m;
+}
