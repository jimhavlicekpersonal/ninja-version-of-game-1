{
  "name": "kagemura",
  "private": true,
  "version": "0.1.0",
  "description": "Kagemura: Ninja Clans - an original ninja-clan base-building and raiding game.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "test": "vitest run",
    "lint": "eslint .",
    "status": "node tools/status/write.mjs",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/backend/contract",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "server:build": "vite build --config vite.server.config.ts",
    "server:start": "node dist-server/main.js",
    "server:migrate": "node dist-server/migrate.js",
    "server:bench": "node dist-server/bench.js",
    "server:load": "node dist-server/load.js",
    "server:dev": "npm run server:build && npm run server:start",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android",
    "art": "vite --open /tools/art-gallery/",
    "brand": "node tools/brand/brand.mjs",
    "store:screenshots": "node tools/store/screenshots.mjs",
    "store:storekit": "node tools/store/storekit.mjs",
    "docs:progression": "node tools/progression/generate.mjs",
    "balance:armies": "node tools/balance/generate.mjs",
    "balance:campaign": "node tools/balance/run-campaigns.mjs",
    "i18n:extract": "node tools/i18n/i18n.mjs extract",
    "i18n:sync": "node tools/i18n/i18n.mjs sync",
    "i18n:status": "node tools/i18n/i18n.mjs status",
    "i18n:check": "node tools/i18n/i18n.mjs check",
    "i18n:next": "node tools/i18n/i18n.mjs next",
    "perf:lowend": "node tools/perf/lowend.mjs",
    "perf:profile": "node tools/perf/profile.mjs",
    "balance:bundle": "node tools/balance/bundle.mjs",
    "rules:fixture": "node tools/release/rules-snapshot.mjs fixture",
    "rules:snapshot": "node tools/release/rules-snapshot.mjs snapshot",
    "i18n:build": "node tools/i18n/build.mjs",
    "i18n:size": "npm run build && node tools/i18n/build.mjs --quiet --measure-dist",
    "pretest": "node tools/i18n/build.mjs --quiet",
    "pretypecheck": "node tools/i18n/build.mjs --quiet",
    "pretypecheck:server": "node tools/i18n/build.mjs --quiet",
    "prebuild": "node tools/i18n/build.mjs --quiet",
    "i18n:smoke": "node tools/i18n/smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "phaser": "^3.90.0",
    "unicode-segmenter": "0.17.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
