{
  "name": "toadstool-kingdoms",
  "private": true,
  "version": "0.1.0",
  "description": "Toadstool Kingdoms - an original cartoon-fantasy base-building and raiding game.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
